{;; jolt-microvm drives libkrun (by-value FFI) through jolt-libkrun and the
 ;; jolt-exec guest deps, so it floors at the same 0.8.28 as the rest of the
 ;; sandbox stack.
 :jolt/min-version "0.8.28"

 :paths ["src"]
 :deps {jolt-lang/http-client
        {:git/url "https://github.com/jolt-lang/http-client"
         :git/sha "03267126e0bebe172936e9618b9ff6cd678edaac"}
        jolt-lang/jolt-oci
        {:git/url "https://github.com/racklr-dev/jolt-oci"
         :git/sha "8a36c30d031edc65ba920e827ca35c69eac07caf"}
        jolt-lang/jolt-libkrun
        {:git/url "https://github.com/racklr-dev/jolt-libkrun"
         :git/sha "1e6dc52f7730c92b210456fd0bcb37272995859f"}
        jolt-lang/jolt-pty
        {:git/url "https://github.com/racklr-dev/jolt-pty"
         :git/sha "5c0c045ddf8e10b341ffe42efefa894db1545ebe"}
        jolt-lang/jolt-exec
        {:git/url "https://github.com/racklr-dev/jolt-exec"
         :git/sha "6cc6032504762c4b4867278e502421e96bd10cd8"}
        jolt-lang/jolt-tapmasq
        {:git/url "https://github.com/racklr-dev/jolt-tapmasq"
         :git/sha "fbf8950a13c8e15393bd1de2783d86527b213f1c"}}

 :tasks {test "jolt run test/jolt/check_test.clj"}}